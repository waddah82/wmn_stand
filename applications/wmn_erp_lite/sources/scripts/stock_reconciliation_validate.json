{
  "language": "wmn-procedure-v1",
  "version": 1,
  "steps": [
    {
      "op": "db_get",
      "doctype": "Company",
      "name": {
        "get": "doc.company"
      },
      "as": "company"
    },
    {
      "op": "set",
      "path": "doc.stock_account",
      "value": {
        "coalesce": [
          {
            "get": "doc.stock_account"
          },
          {
            "field": {
              "from": {
                "get": "company"
              },
              "name": "default_stock_account"
            }
          }
        ]
      }
    },
    {
      "op": "set",
      "path": "doc.adjustment_account",
      "value": {
        "coalesce": [
          {
            "get": "doc.adjustment_account"
          },
          {
            "field": {
              "from": {
                "get": "company"
              },
              "name": "default_stock_adjustment_account"
            }
          }
        ]
      }
    },
    {
      "op": "assert",
      "test": {
        "gt": [
          {
            "len": {
              "get": "doc.items"
            }
          },
          0
        ]
      },
      "message": "Stock Reconciliation requires items."
    },
    {
      "op": "set",
      "path": "doc.value_difference",
      "value": 0
    },
    {
      "op": "for_each",
      "items": {
        "get": "doc.items"
      },
      "as": "row",
      "steps": [
        {
          "op": "assert",
          "test": {
            "gte": [
              {
                "get": "row.quantity"
              },
              0
            ]
          },
          "message": "Reconciled quantity cannot be negative."
        },
        {
          "op": "assert",
          "test": {
            "gte": [
              {
                "get": "row.valuation_rate"
              },
              0
            ]
          },
          "message": "Valuation Rate cannot be negative."
        },
        {
          "op": "db_get",
          "doctype": "Bin",
          "filters": [
            [
              "item_code",
              "=",
              {
                "get": "row.item_code"
              }
            ],
            [
              "warehouse",
              "=",
              {
                "get": "row.warehouse"
              }
            ]
          ],
          "as": "bin"
        },
        {
          "op": "let",
          "name": "old_value",
          "value": {
            "coalesce": [
              {
                "field": {
                  "from": {
                    "get": "bin"
                  },
                  "name": "stock_value"
                }
              },
              0
            ]
          }
        },
        {
          "op": "let",
          "name": "new_value",
          "value": {
            "round": {
              "value": {
                "mul": [
                  {
                    "get": "row.quantity"
                  },
                  {
                    "get": "row.valuation_rate"
                  }
                ]
              },
              "precision": 2
            }
          }
        },
        {
          "op": "set",
          "path": "doc.value_difference",
          "value": {
            "round": {
              "value": {
                "add": [
                  {
                    "get": "doc.value_difference"
                  },
                  {
                    "sub": [
                      {
                        "get": "new_value"
                      },
                      {
                        "get": "old_value"
                      }
                    ]
                  }
                ]
              },
              "precision": 2
            }
          }
        }
      ]
    }
  ]
}
