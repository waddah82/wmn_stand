{
  "language": "wmn-procedure-v1",
  "version": 1,
  "steps": [
    {
      "op": "db_get",
      "doctype": "Company",
      "name": {
        "get": "doc.company"
      },
      "as": "company"
    },
    {
      "op": "assert",
      "test": {
        "not_empty": {
          "get": "company"
        }
      },
      "message": "Company is required and must exist."
    },
    {
      "op": "set",
      "path": "doc.stock_account",
      "value": {
        "coalesce": [
          {
            "get": "doc.stock_account"
          },
          {
            "field": {
              "from": {
                "get": "company"
              },
              "name": "default_stock_account"
            }
          }
        ]
      }
    },
    {
      "op": "set",
      "path": "doc.adjustment_account",
      "value": {
        "coalesce": [
          {
            "get": "doc.adjustment_account"
          },
          {
            "field": {
              "from": {
                "get": "company"
              },
              "name": "default_stock_adjustment_account"
            }
          }
        ]
      }
    },
    {
      "op": "assert",
      "test": {
        "gt": [
          {
            "len": {
              "get": "doc.items"
            }
          },
          0
        ]
      },
      "message": "Stock Entry requires at least one item."
    },
    {
      "op": "for_each",
      "items": {
        "get": "doc.items"
      },
      "as": "row",
      "steps": [
        {
          "op": "db_get",
          "doctype": "Item",
          "name": {
            "get": "row.item_code"
          },
          "as": "item"
        },
        {
          "op": "assert",
          "test": {
            "not_empty": {
              "get": "item"
            }
          },
          "message": "Unknown Item {{ row.item_code }}."
        },
        {
          "op": "assert",
          "test": {
            "not": {
              "eq": [
                {
                  "field": {
                    "from": {
                      "get": "item"
                    },
                    "name": "disabled"
                  }
                },
                1
              ]
            }
          },
          "message": "Item {{ row.item_code }} is disabled."
        },
        {
          "op": "assert",
          "test": {
            "gt": [
              {
                "get": "row.qty"
              },
              0
            ]
          },
          "message": "Quantity must be greater than zero."
        },
        {
          "op": "set",
          "path": "row.uom",
          "value": {
            "coalesce": [
              {
                "get": "row.uom"
              },
              {
                "field": {
                  "from": {
                    "get": "item"
                  },
                  "name": "stock_uom"
                }
              }
            ]
          }
        },
        {
          "op": "set",
          "path": "row.source_warehouse",
          "value": {
            "coalesce": [
              {
                "get": "row.source_warehouse"
              },
              {
                "get": "doc.from_warehouse"
              }
            ]
          }
        },
        {
          "op": "set",
          "path": "row.target_warehouse",
          "value": {
            "coalesce": [
              {
                "get": "row.target_warehouse"
              },
              {
                "get": "doc.to_warehouse"
              }
            ]
          }
        },
        {
          "op": "if",
          "test": {
            "eq": [
              {
                "get": "doc.stock_entry_type"
              },
              "Material Receipt"
            ]
          },
          "then": [
            {
              "op": "assert",
              "test": {
                "not_empty": {
                  "get": "row.target_warehouse"
                }
              },
              "message": "Target Warehouse is required for Material Receipt."
            },
            {
              "op": "set",
              "path": "row.basic_rate",
              "value": {
                "if": {
                  "test": {
                    "gt": [
                      {
                        "coalesce": [
                          {
                            "get": "row.basic_rate"
                          },
                          0
                        ]
                      },
                      0
                    ]
                  },
                  "then": {
                    "get": "row.basic_rate"
                  },
                  "else": {
                    "coalesce": [
                      {
                        "field": {
                          "from": {
                            "get": "item"
                          },
                          "name": "valuation_rate"
                        }
                      },
                      0
                    ]
                  }
                }
              }
            }
          ],
          "else": [
            {
              "op": "assert",
              "test": {
                "not_empty": {
                  "get": "row.source_warehouse"
                }
              },
              "message": "Source Warehouse is required for Material Issue/Transfer."
            },
            {
              "op": "db_get",
              "doctype": "Bin",
              "filters": [
                [
                  "item_code",
                  "=",
                  {
                    "get": "row.item_code"
                  }
                ],
                [
                  "warehouse",
                  "=",
                  {
                    "get": "row.source_warehouse"
                  }
                ]
              ],
              "as": "source_bin"
            },
            {
              "op": "assert",
              "test": {
                "gte": [
                  {
                    "coalesce": [
                      {
                        "field": {
                          "from": {
                            "get": "source_bin"
                          },
                          "name": "actual_qty"
                        }
                      },
                      0
                    ]
                  },
                  {
                    "get": "row.qty"
                  }
                ]
              },
              "message": "Insufficient stock for {{ row.item_code }} in {{ row.source_warehouse }}."
            },
            {
              "op": "set",
              "path": "row.basic_rate",
              "value": {
                "coalesce": [
                  {
                    "field": {
                      "from": {
                        "get": "source_bin"
                      },
                      "name": "valuation_rate"
                    }
                  },
                  0
                ]
              }
            }
          ]
        },
        {
          "op": "if",
          "test": {
            "eq": [
              {
                "get": "doc.stock_entry_type"
              },
              "Material Transfer"
            ]
          },
          "then": [
            {
              "op": "assert",
              "test": {
                "not_empty": {
                  "get": "row.target_warehouse"
                }
              },
              "message": "Target Warehouse is required for Material Transfer."
            },
            {
              "op": "assert",
              "test": {
                "ne": [
                  {
                    "get": "row.source_warehouse"
                  },
                  {
                    "get": "row.target_warehouse"
                  }
                ]
              },
              "message": "Source and Target Warehouses must be different."
            }
          ]
        },
        {
          "op": "set",
          "path": "row.amount",
          "value": {
            "round": {
              "value": {
                "mul": [
                  {
                    "get": "row.qty"
                  },
                  {
                    "get": "row.basic_rate"
                  }
                ]
              },
              "precision": 2
            }
          }
        }
      ]
    },
    {
      "op": "set",
      "path": "doc.total_value",
      "value": {
        "round": {
          "value": {
            "sum": {
              "items": {
                "get": "doc.items"
              },
              "as": "r",
              "value": {
                "get": "r.amount"
              }
            }
          },
          "precision": 2
        }
      }
    }
  ]
}
