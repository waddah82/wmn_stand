                  {
                    "get": "row.item_code"
                  }
                ],
                [
                  "warehouse",
                  "=",
                  {
                    "get": "row.target_warehouse"
                  }
                ]
              ],
              "as": "bin"
            },
            {
              "op": "let",
              "name": "old_qty",
              "value": {
                "coalesce": [
                  {
                    "field": {
                      "from": {
                        "get": "bin"
                      },
                      "name": "actual_qty"
                    }
                  },
                  0
                ]
              }
            },
            {
              "op": "let",
              "name": "old_rate",
              "value": {
                "coalesce": [
                  {
                    "field": {
                      "from": {
                        "get": "bin"
                      },
                      "name": "valuation_rate"
                    }
                  },
                  0
                ]
              }
            },
            {
              "op": "let",
              "name": "old_value",
              "value": {
                "coalesce": [
                  {
                    "field": {
                      "from": {
                        "get": "bin"
                      },
                      "name": "stock_value"
                    }
                  },
                  0
                ]
              }
            },
            {
              "op": "let",
              "name": "new_qty",
              "value": {
                "add": [
                  {
                    "get": "old_qty"
                  },
                  {
                    "get": "row.qty"
                  }
                ]
              }
            },
            {
              "op": "let",
              "name": "new_value",
              "value": {
                "round": {
                  "value": {
                    "add": [
                      {
                        "get": "old_value"
                      },
                      {
                        "get": "row.amount"
                      }
                    ]
                  },
                  "precision": 2
                }
              }
            },
            {
              "op": "let",
              "name": "new_rate",
              "value": {
                "if": {
                  "test": {
                    "gt": [
                      {
                        "get": "new_qty"
                      },
                      0
                    ]
                  },
                  "then": {
                    "div": [
                      {
                        "get": "new_value"
                      },
                      {
                        "get": "new_qty"
                      }
                    ]
                  },
