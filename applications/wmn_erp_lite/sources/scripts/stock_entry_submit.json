{
  "language": "wmn-procedure-v1",
  "version": 1,
  "steps": [
    {
      "op": "for_each",
      "items": {
        "get": "doc.items"
      },
      "as": "row",
      "index_as": "line_index",
      "steps": [
        {
          "op": "if",
          "test": {
            "eq": [
              {
                "get": "doc.stock_entry_type"
